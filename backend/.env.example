# ============================================================================
# DispatchAI — пример конфигурации backend
# Скопируйте в backend/.env и при необходимости измените.
# Полная инструкция: backend/Instruction.md; архитектура: backend/Description.md
# ============================================================================

# --- База данных -----------------------------------------------------------
# Локально: SQLite (схема управляется Alembic).
DATABASE_URL=sqlite+aiosqlite:///./dispatcher.db
# Продакшен: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://dispatcher_user:CHANGE_ME@localhost:5432/dispatcher_db
# ALEMBIC_DATABASE_URL=

# --- Приложение ------------------------------------------------------------
APP_NAME=DispatchAI
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173
SEED_DEMO_DATA=true
MAX_UPLOAD_MB=30
MAX_AUDIO_MB=60

# --- Текст -> JSON: Qwen3 через Ollama -------------------------------------
# auto | ollama | openai | gemini | rule
AI_PROVIDER=auto
AI_AUTO_ANALYZE=true
AI_TIMEOUT_SECONDS=300
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_THINK=false
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_KEEP_ALIVE=2m

# Резерв: OpenAI-совместимый сервер
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Резерв: Google Gemini
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_STT_LANGUAGE=ru-RU

# --- Vision: Qwen3-VL через Ollama -----------------------------------------
# auto | ollama | gemini | none
VISION_PROVIDER=auto
OLLAMA_VISION_MODEL=qwen3-vl:2b
OLLAMA_VISION_NUM_CTX=4096
OLLAMA_VISION_NUM_PREDICT=256
GEMINI_VISION_MODEL=
VISION_TIMEOUT_SECONDS=240

# --- Распознавание речи: T-one ---------------------------------------------
# auto | tone | http | local | google | none
SPEECH_PROVIDER=auto
SPEECH_TIMEOUT_SECONDS=120
TONE_BASE_URL=http://localhost:8002
TONE_API_KEY=
TONE_MODEL=t-one
TONE_ENDPOINT=/audio/transcriptions
TONE_FILE_FIELD=file
TONE_LANGUAGE=ru
TONE_TIMEOUT_SECONDS=300
TONE_WS_URL=

# Резервный Whisper по HTTP
WHISPER_BASE_URL=
WHISPER_API_KEY=
WHISPER_HTTP_MODEL=Systran/faster-whisper-small
# Резервный faster-whisper в процессе backend
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# --- Синтез речи: Silero TTS -----------------------------------------------
# silero | none
TTS_PROVIDER=silero
TTS_ENABLED=true
SILERO_TTS_URL=http://localhost:8003
SILERO_TTS_ENDPOINT=/tts
SILERO_SPEAKER=aidar
SILERO_LANGUAGE=ru
SILERO_SAMPLE_RATE=24000
SILERO_TIMEOUT_SECONDS=60

# --- Qdrant и база знаний ---------------------------------------------------
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_articles
QDRANT_TOP_K=5
# ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=

# --- Телефония -------------------------------------------------------------
SIP_WEBHOOK_TOKEN=
SIP_AUTO_ANALYZE=true

ARI_ENABLED=false
ARI_URL=http://localhost:8088
ARI_WS_URL=
ARI_USERNAME=dispatchai
ARI_PASSWORD=
ARI_APP=dispatchai
ARI_RECORD=true
ARI_GREETING_MEDIA=
ARI_AUTO_ANALYZE=true
ARI_RECORDING_FORMAT=wav
ARI_RECONNECT_SECONDS=5
ARI_VERIFY_SSL=true
