# Backend
DATABASE_URL=sqlite+aiosqlite:///./dispatcher.db

# Для Postgres в Docker:
# DATABASE_URL=postgresql+asyncpg://dispatcher_user:ef6a998e815ad6513ffe2f4a749208f3e269f24b43384d03f9acb2f5cb343169@localhost:5432/dispatcher_db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173

# ИИ: auto -> Gemini при наличии ключа, иначе офлайн-анализатор
# Другие режимы: gemini | ollama | openai | rule
AI_PROVIDER=auto
AI_AUTO_ANALYZE=true
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_STT_LANGUAGE=ru-RU
AI_TIMEOUT_SECONDS=20

# Локальная текстовая модель Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Локальный OpenAI-совместимый сервер (LM Studio, llama.cpp, vLLM)
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=

# Распознавание речи: auto | local | http | google | none
SPEECH_PROVIDER=auto
# HTTP Whisper (faster-whisper-server), база включает /v1
WHISPER_BASE_URL=
WHISPER_HTTP_MODEL=Systran/faster-whisper-small
# Локальный faster-whisper (pip install faster-whisper)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# SIP-шлюз: токен для webhook'ов от Asterisk/FreeSWITCH
SIP_WEBHOOK_TOKEN=
SIP_AUTO_ANALYZE=true

# ARI (Asterisk REST Interface): backend сам слушает события АТС
ARI_ENABLED=false
ARI_URL=http://localhost:8088
ARI_USERNAME=dispatchai
ARI_PASSWORD=
ARI_APP=dispatchai
# Полный URL можно задать явно, если ARI за reverse proxy:
# ARI_WS_URL=ws://asterisk:8088/ari/events
ARI_RECORD=true
ARI_GREETING_MEDIA=
ARI_AUTO_ANALYZE=true
ARI_RECORDING_FORMAT=wav
ARI_RECONNECT_SECONDS=5
ARI_VERIFY_SSL=true

# Лимиты загрузки
MAX_UPLOAD_MB=30
MAX_AUDIO_MB=60
